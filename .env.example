# Copy to .env and replace every change-me value. .env is ignored by Git.
POSTGRES_USER=netopier
POSTGRES_PASSWORD=change-me-postgres
MINIFLUX_ADMIN_USERNAME=netopier
MINIFLUX_ADMIN_PASSWORD=change-me-miniflux
MINIFLUX_BASE_URL=http://miniflux:8080
NETOPIER_DATABASE_URL=postgresql://netopier:change-me-postgres@postgres:5432/netopier
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/var/cache/netopier/models
STORY_SIMILARITY_THRESHOLD=0.83
STORY_WINDOW_HOURS=72
RECONCILIATION_BATCH_SIZE=20
WORKER_INTERVAL_SECONDS=300
